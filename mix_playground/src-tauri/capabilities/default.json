{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "macos-permissions:default",
    "shell:allow-spawn",
    "dialog:allow-confirm",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "mix",
          "sidecar": true,
          "args": [
            "-c",
            {
              "validator": "^/.*"
            },
            "--http-port",
            {
              "validator": "^\\d+$"
            },
            "--dangerously-skip-permissions",
            "-d"
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "mix",
          "sidecar": true,
          "args": [
            "-c",
            {
              "validator": "^/.*"
            },
            "--http-port",
            {
              "validator": "^\\d+$"
            },
            "--dangerously-skip-permissions",
            "-d"
          ]
        }
      ]
    },
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-exists",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/**/*" }]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "validator": "^((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)).+|^(\\.?/|file://|[A-Za-z]:[/\\\\])"
        }
      ]
    }
  ]
}
