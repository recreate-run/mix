{
  "name": "bounce-overlay",
  "description": "Bold text animates over video with energetic character-by-character entrance effects, featuring bouncing motion, scale pulses, and staggered timing that creates dynamic rhythmic text movement throughout the sequence",
  "version": "1.0.0",
  "parameters": [
    {
      "name": "overlayText",
      "type": "string",
      "default": "Let's go!"
    },
    {
      "name": "totalAnimationDurationSeconds",
      "type": "number",
      "default": 3
    },
    {
      "name": "textSizeRem",
      "type": "number",
      "default": 3
    },
    {
      "name": "textColor",
      "type": "color",
      "default": "#fff"
    },
    {
      "name": "backgroundCSS",
      "type": "string",
      "default": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
    },
    {
      "name": "backgroundVideoUrl",
      "type": "string",
      "default": ""
    },
    {
      "name": "characterBounceHeightPixels",
      "type": "number",
      "default": 20
    },
    {
      "name": "characterAnimationDelaySeconds",
      "type": "number",
      "default": 0.05
    },
    {
      "name": "maxPulseScaleFactor",
      "type": "number",
      "default": 1.1
    },
    {
      "name": "textShadowIntensityMultiplier",
      "type": "number",
      "default": 1
    },
    {
      "name": "autoloop",
      "type": "boolean",
      "default": false
    },
    {
      "name": "aspectRatio",
      "type": "string",
      "default": "9/16"
    }
  ]
}