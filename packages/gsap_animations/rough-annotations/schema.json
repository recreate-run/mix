{
  "name": "rough-annotations",
  "description": "Single word with elegant rough-notation underline animation, featuring smooth text entrance and organic hand-drawn underline effect",
  "version": "1.0.0",
  "parameters": [
    {
      "name": "singleWord",
      "type": "string",
      "default": "Amazing"
    },
    {
      "name": "underlineColor",
      "type": "color",
      "default": "#FF6B6B"
    },
    {
      "name": "animationDuration",
      "type": "number",
      "default": 1.5
    },
    {
      "name": "strokeWidth",
      "type": "number",
      "default": 3
    },
    {
      "name": "textSizeRem",
      "type": "number",
      "default": 4
    },
    {
      "name": "textColor",
      "type": "color",
      "default": "#2D3748"
    },
    {
      "name": "backgroundCSS",
      "type": "string",
      "default": "linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%)"
    },
    {
      "name": "fontFamily",
      "type": "string",
      "default": "Inter, system-ui, sans-serif"
    },
    {
      "name": "padding",
      "type": "number",
      "default": 4
    },
    {
      "name": "autoloop",
      "type": "boolean",
      "default": false
    },
    {
      "name": "aspectRatio",
      "type": "string",
      "default": "9/16"
    }
  ]
}