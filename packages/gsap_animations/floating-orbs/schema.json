{
  "name": "floating-orbs",
  "description": "Four colorful blurred circles drift gracefully across the screen in fluid motion while text fades in and out at the center, creating mesmerizing ambient movement",
  "version": "1.0.0",
  "parameters": [
    {
      "name": "displayText",
      "type": "string",
      "default": "Meet Mix: Your local multimodal agent"
    },
    {
      "name": "animationDurationSeconds",
      "type": "number",
      "default": 3
    },
    {
      "name": "textSizeRem",
      "type": "number",
      "default": 3
    },
    {
      "name": "textColor",
      "type": "color",
      "default": "#111"
    },
    {
      "name": "canvasBackgroundColor",
      "type": "color",
      "default": "#d1fae5"
    },
    {
      "name": "backgroundVideoUrl",
      "type": "string",
      "default": ""
    },
    {
      "name": "primaryBlobColor",
      "type": "color",
      "default": "#84fab0"
    },
    {
      "name": "secondaryBlobColor",
      "type": "color",
      "default": "#8fd3f4"
    },
    {
      "name": "tertiaryBlobColor",
      "type": "color",
      "default": "#fbc2eb"
    },
    {
      "name": "quaternaryBlobColor",
      "type": "color",
      "default": "#7dd3fc"
    },
    {
      "name": "blobOpacityLevel",
      "type": "number",
      "default": 0.6
    },
    {
      "name": "blobBlurRadiusPixels",
      "type": "number",
      "default": 80
    },
    {
      "name": "autoloop",
      "type": "boolean",
      "default": false
    },
    {
      "name": "aspectRatio",
      "type": "string",
      "default": "9/16"
    }
  ]
}