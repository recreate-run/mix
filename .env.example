# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8088

# Backend Configuration
# Base URL for constructing file URLs returned by the API

# Development & Debug Configuration
# ==================================
# _DEV_DEBUG: Enable development debug features
#   - "true": Enable debug logging and features (e.g., browser bounding box visualizations)
#   - "false" or unset: Disable debug features (production mode)
# When enabled, browser analyze_screenshot tool saves to debug_screenshots/{timestamp}/:
#   - screenshot_raw.png (original unmodified screenshot)
#   - screenshot_overlayed.jpg (annotated with bounding boxes and center points)
#   - prompt.txt (the analysis prompt used)
_DEV_DEBUG=true

# Browser Configuration
# =====================
# BROWSER_MODE: Select browser implementation
#   - "electron-embedded-browser" (default): Use Electron app with embedded Chromium browser
#       * Start the Electron app from: ../browser-use-trial/mix-browser-app
#       * Electron app connects to Mix agent via WebSocket tunnel
#       * Recommended for desktop use with full UI control
#   - "local-browser-service": Use local browser-service (GoRod-based)
#       * Requires separate browser-service process running
#       * Headless automation without Electron overhead
#   - "remote-cdp-websocket": Connect to remote browser via CDP WebSocket URL
#       * Used with cloud browser providers (Browserbase, Brightdata, etc.)
#       * CDP URL specified per-session via API
BROWSER_MODE=electron-embedded-browser

# BROWSER_SERVICE_URL: WebSocket URL for browser-service (only used when BROWSER_MODE=local-browser-service)
# To enable local-browser-service mode:
#   1. Set BROWSER_MODE=local-browser-service
#   2. Start browser-service on the configured URL
#   3. Restart Mix agent
BROWSER_SERVICE_URL=ws://localhost:8081/ws

# Database Configuration
# To set up automatically, run: ./scripts/setup-turso.sh
MIX_DB_TYPE=turso
MIX_DB_TURSO_URL=libsql://mix-db-username.aws-ap-south-1.turso.io
MIX_DB_TURSO_AUTH_TOKEN=xyz

# Storage Configuration
# =====================
# Type: "local" (default) or "supabase" (for remote storage)
STORAGE_TYPE=local
STORAGE_ENDPOINT=./storage

# Supabase Storage Configuration
# To set up automatically, run: ./scripts/setup-supabase.sh
# Or manually uncomment and configure when using Supabase:
# STORAGE_TYPE=supabase
# STORAGE_ENDPOINT=https://your-project.supabase.co
# STORAGE_BUCKET=mix-storage
# STORAGE_ACCESS_KEY=your-service-role-key