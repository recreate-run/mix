# Database Configuration
# Options: sqlite, turso, postgres
MIX_DB_TYPE=postgres

# SQLite Configuration (used when MIX_DB_TYPE=sqlite)
MIX_DB_SQLITE_DATA_DIR=./data
MIX_DB_SQLITE_FILENAME=mix.db

# Turso Configuration (used when MIX_DB_TYPE=turso)
MIX_DB_TURSO_URL=libsql://[databaseId]-[organizationName].turso.io
MIX_DB_TURSO_AUTH_TOKEN=your_turso_auth_token

# PostgreSQL Configuration (used when MIX_DB_TYPE=postgres)
MIX_DB_POSTGRES_HOST=localhost
MIX_DB_POSTGRES_PORT=5432
MIX_DB_POSTGRES_DB=mix_dev
MIX_DB_POSTGRES_USER=mix
MIX_DB_POSTGRES_PASSWORD=mix_local_dev
MIX_DB_POSTGRES_SSL_MODE=disable
